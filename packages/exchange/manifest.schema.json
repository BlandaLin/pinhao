{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pinhao.example/schemas/text-package/0.2/manifest.json",
  "title": "PinHao Text Package 0.2 Manifest (with 0.1 read compatibility)",
  "type": "object",
  "required": ["format", "version", "packageId", "projectId", "sourceRevision", "targetLanguage", "profile", "editable", "mode", "unitIds", "requiredCapabilities", "files"],
  "properties": {
    "format": { "const": "pinhao-text-package" },
    "version": { "enum": ["0.1", "0.2"] },
    "packageId": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "sourceRevision": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "targetLanguage": { "type": "string", "minLength": 2 },
    "profile": { "enum": ["json", "text"] },
    "editable": { "enum": ["editable/units.json", "editable/units.txt"] },
    "mode": { "const": "complete" },
    "taskStage": { "enum": ["translation", "proofreading"] },
    "unitIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "referenceUnitIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "requiredCapabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "extensions": { "type": "object" },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["sha256", "mutable"],
        "properties": { "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "mutable": { "type": "boolean" } },
        "additionalProperties": false
      }
    }
  },
  "allOf": [{
    "if": { "properties": { "version": { "const": "0.2" } } },
    "then": { "required": ["taskStage", "referenceUnitIds"] }
  }],
  "additionalProperties": true
}
